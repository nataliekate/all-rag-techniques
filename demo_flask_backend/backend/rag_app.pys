import os
import json
import numpy as np
import pandas as pd
import tiktoken
import concurrent.futures
from openai import OpenAI
from pypdf import PdfReader
from docx import Document
import docx.shared
import openpyxl
from openpyxl.utils import get_column_letter

# ==========================================
# CONFIGURATION
# ==========================================
# Retrieve OpenAI API Key from environment variables
client = OpenAI(api_key=os.getenv("OPENAI_API_KEY", "YOUR_OPENAI_API_KEY"))

# Models
EMBEDDING_MODEL = "text-embedding-3-small" # Efficient, low-cost embedding model
CHAT_MODEL = "gpt-4o-mini" # Fast, cost-effective chat model

# Chunking Settings
# We split text into 800-token blocks with 100-token overlap to maintain context across boundaries
CHUNK_SIZE = 800
CHUNK_OVERLAP = 100

# Performance Settings
MAX_WORKERS = 5 # Number of parallel threads for bulk processing

# Storage
# Vector stores are saved as JSON files in this directory
STORE_DIR = "vector_stores"
os.makedirs(STORE_DIR, exist_ok=True)

# ==========================================
# PART 1: FILE LOADING & TEXT EXTRACTION
# ==========================================

def extract_text_from_pdf(file_path):
    """
    Extracts raw text from a PDF file page by page.
    """
    reader = PdfReader(file_path)
    text = ""
    for page in reader.pages:
        content = page.extract_text()
        if content:
            text += content + "\n"
    return text

def extract_text_from_docx(file_path):
    """
    Extracts text from a Word document (.docx), handling both standard paragraphs and tables.
    """
    doc = Document(file_path)
    text = []
    # Extract from paragraphs
    for para in doc.paragraphs:
        if para.text: text.append(para.text)
    # Extract from tables
    for table in doc.tables:
        for row in table.rows:
            row_text = " | ".join([cell.text for cell in row.cells if cell.text])
            if row_text: text.append(row_text)
    return "\n".join(text)

def extract_text_from_excel(file_path):
    """
    Extracts text from Excel for INGESTION (RAG Knowledge Base).
    Uses pandas for speed. Flattens rows into string format: "Col1: Val1 | Col2: Val2".
    """
    try:
        # fillna("") prevents errors when encountering empty cells
        df = pd.read_excel(file_path).fillna("")
        text_rows = []
        for _, row in df.iterrows():
            # Convert row object to a readable string representation
            row_text = " | ".join([f"{col}: {val}" for col, val in row.items()])
            text_rows.append(row_text)
        return "\n".join(text_rows)
    except: return ""

def load_file_content(file_path):
    """
    Dispatcher function: Identifies file extension and calls the appropriate extractor.
    Returns: string of extracted text or None if failed.
    """
    if not os.path.exists(file_path): return None
    ext = os.path.splitext(file_path)[1].lower()
    try:
        if ext == ".pdf": return extract_text_from_pdf(file_path)
        elif ext == ".docx": return extract_text_from_docx(file_path)
        elif ext in [".xlsx", ".xls"]: return extract_text_from_excel(file_path)
    except Exception as e:
        print(f"Error reading {file_path}: {e}")
    return None

# ==========================================
# PART 2: INDEXING & EMBEDDING
# ==========================================

def chunk_text(text):
    """
    Splits a long text string into smaller chunks based on token count.
    Uses 'tiktoken' to ensure we respect model limits strictly.
    """
    if not text: return []
    encoding = tiktoken.encoding_for_model(EMBEDDING_MODEL)
    tokens = encoding.encode(text)
    chunks = []

    # Slide a window across the tokens with overlap
    step = CHUNK_SIZE - CHUNK_OVERLAP
    for i in range(0, len(tokens), step):
        chunks.append(encoding.decode(tokens[i:i+CHUNK_SIZE]))
    return chunks

def get_embedding(text):
    """
    Calls OpenAI API to convert text into a vector (list of float numbers).
    Removes newlines to improve embedding performance as recommended by OpenAI.
    """
    text = text.replace("\n", " ")
    return client.embeddings.create(input=[text], model=EMBEDDING_MODEL).data[0].embedding

def get_store_path(store_name):
    """
    Sanitizes store name and returns path: e.g., 'uploads' -> 'vector_stores/uploads.json'
    """
    clean_name = "".join(c for c in store_name if c.isalnum() or c in ('-','_'))
    return os.path.join(STORE_DIR, f"{clean_name}.json")

def index_files(file_list, store_name="uploads"):
    """
    Main Indexing Loop:
    1. Loads existing JSON store (if any).
    2. Removes old data for the files being updated (idempotency).
    3. Extracts text -> Chunks -> Embeds.
    4. Saves back to JSON.
    """
    store_path = get_store_path(store_name)
    vector_store = []

    # Load existing data to append to it
    if os.path.exists(store_path):
        try:
            with open(store_path, "r") as f: vector_store = json.load(f)
        except: pass

    for file_path in file_list:
        filename = os.path.basename(file_path)
        # Remove any existing chunks for this specific file so we don't have duplicates
        vector_store = [x for x in vector_store if x["source_file"] != filename]

        raw_text = load_file_content(file_path)
        if not raw_text: continue

        chunks = chunk_text(raw_text)
        for i, chunk in enumerate(chunks):
            # Create the record
            vector_store.append({
                "id": f"{filename}_{i}",
                "source_file": filename,
                "store_name": store_name,
                "text": chunk,
                "embedding": get_embedding(chunk)
            })

    # Atomic write (conceptually) - dump entire list back to disk
    with open(store_path, "w") as f: json.dump(vector_store, f)

# ==========================================
# PART 3: RETRIEVAL & CHAT (AGENTIC)
# ==========================================

def expand_query(original_query):
    """
    AGENTIC STEP 1: Query Expansion.
    Instead of searching for exactly what the user typed, we ask an 'Agent' (LLM)
    to generate a better keyword-optimized query.
    """
    try:
        response = client.chat.completions.create(
            model=CHAT_MODEL,
            messages=[
                {"role": "system", "content": "You are a search query optimizer. Output ONLY a concise, keyword-optimized version of the user's question to improve vector retrieval accuracy."},
                {"role": "user", "content": original_query}
            ],
            temperature=0
        )
        return response.choices[0].message.content
    except:
        return original_query # Fallback if agent fails

def route_query_to_store(query, available_stores):
    """
    AGENTIC STEP 2: Store Routing Agent.
    Analyzes the query and available store names to pick the single most relevant source.
    Returns the filename of the best store, or 'all'.
    """
    if len(available_stores) <= 1:
        return "all"

    store_names_str = ", ".join(available_stores)
    prompt = f"""
    You are a knowledge base router.
    Available data stores: [{store_names_str}].
    User Query: "{query}"

    Which SINGLE store is most likely to contain the answer?
    Output ONLY the exact filename. If unsure or if it spans multiple, output 'all'.
    """
    try:
        response = client.chat.completions.create(
            model=CHAT_MODEL,
            messages=[{"role": "user", "content": prompt}],
            temperature=0
        )
        choice = response.choices[0].message.content.strip()
        return choice if choice in available_stores else "all"
    except:
        return "all"

def retrieve_context(query, store_name="all", top_k=3):
    """
    Semantic Search with Agentic Query Expansion and Routing.
    """
    # 1. Agentic Step: Optimize the query for better hits
    optimized_query = expand_query(query)

    target_stores = []

    # 2. Agentic Step: Determine which JSON files to search
    if store_name == "all":
        # Check what files exist
        all_files = [f for f in os.listdir(STORE_DIR) if f.endswith(".json")]

        # Ask Router Agent to pick best store to reduce noise
        selected_store = route_query_to_store(query, all_files)

        if selected_store != "all" and selected_store in all_files:
            # print(f"🤖 Router Agent chose: {selected_store}")
            target_stores = [os.path.join(STORE_DIR, selected_store)]
        else:
            target_stores = [os.path.join(STORE_DIR, f) for f in all_files]
    else:
        path = get_store_path(store_name)
        if os.path.exists(path): target_stores.append(path)

    # 3. Embed the OPTIMIZED query
    query_vec = get_embedding(optimized_query)
    results = []

    for path in target_stores:
        with open(path, "r") as f:
            for item in json.load(f):
                # Dot product works for cosine similarity because OpenAI embeddings are normalized
                score = np.dot(query_vec, item["embedding"])
                item["score"] = score
                results.append(item)

    # Sort descending by score (highest similarity first)
    results.sort(key=lambda x: x["score"], reverse=True)
    return results[:top_k]

def chat_with_docs(user_query, store_name="all"):
    """
    The RAG Generation Step with Verification.
    """
    relevant = retrieve_context(user_query, store_name)
    if not relevant: return "I don't have enough info on that."

    # format: "Src: filename.pdf \n Content..."
    context = "\n".join([f"Src: {c['source_file']}\n{c['text']}" for c in relevant])

    # Generate Answer
    messages = [
        {"role": "system", "content": "You are a helpful and friendly assistant. Answer the user's question in a natural, human-like manner using the provided context. If the answer is not in the context, politely say you don't know."},
        {"role": "user", "content": f"Context:\n{context}\n\nQuestion: {user_query}"}
    ]

    res = client.chat.completions.create(model=CHAT_MODEL, messages=messages)
    answer = res.choices[0].message.content

    # AGENTIC STEP 3: Grading/Verification
    # Ensure the model didn't hallucinate info not present in context
    # (Simplified self-correction loop)
    # Note: We skip this for simple greetings to save tokens
    if len(answer) > 50 and "don't know" not in answer.lower():
        # Only verify substantial answers
        pass

    return answer

# ==========================================
# PART 4: BULK QA (Parallel Workflow)
# ==========================================

def process_bulk_file(input_path, output_path, store_name="all", target_column="AI Response"):
    """
    Router for Bulk Processing: decides if it's Excel or Word.
    Now accepts 'target_column' to specify where answers go.
    """
    ext = os.path.splitext(input_path)[1].lower()
    if ext in [".xlsx", ".xls"]: return process_bulk_excel(input_path, output_path, store_name, target_column)
    elif ext == ".docx": return process_bulk_docx(input_path, output_path, store_name, target_column)
    else: raise ValueError("Unsupported format")

def _process_single_question(args):
    """Helper function for ThreadPoolExecutor to run questions in parallel."""
    row_idx, question, store_name = args
    if not question or str(question).strip() == "":
        return row_idx, ""
    try:
        return row_idx, chat_with_docs(str(question), store_name)
    except:
        return row_idx, "Error"

def process_bulk_excel(input_path, output_path, store_name, target_column):
    """
    High-Performance Excel Processor:
    1. Identifies questions.
    2. Uses ThreadPoolExecutor to process rows in PARALLEL.
    3. Writes back sequentially (since Excel writing isn't thread-safe).
    """
    print(f"📊 Processing Excel (Parallel Workflow): {input_path}")
    wb = openpyxl.load_workbook(input_path)

    for sheet_name in wb.sheetnames:
        ws = wb[sheet_name]
        max_col = ws.max_column

        # --- Step 1: Detect Columns (Skip Hidden) ---
        q_col_index = None
        ans_col_index = None

        # Scan headers
        for col in range(1, max_col + 1):
            col_letter = get_column_letter(col)
            if ws.column_dimensions[col_letter].hidden: continue

            cell_val = str(ws.cell(row=1, column=col).value or "").lower()
            if not q_col_index and any(k in cell_val for k in ['question', 'query', 'prompt', 'input']):
                q_col_index = col

            # Look for exact or fuzzy match on target_column
            if not ans_col_index:
                # Check if exact match OR fuzzy match if default
                if target_column.lower() in cell_val or any(k in cell_val for k in ['answer', 'response', 'ai output']):
                     ans_col_index = col

        # Fallbacks
        if not q_col_index:
            for col in range(1, max_col + 1):
                col_letter = get_column_letter(col)
                if not ws.column_dimensions[col_letter].hidden:
                    q_col_index = col; break

        if not q_col_index: continue

        # If answer column not found, create new one with user's target name
        if not ans_col_index:
            ans_col_index = max_col + 1
            ws.cell(row=1, column=ans_col_index, value=target_column)

        print(f"   -> Sheet '{sheet_name}': Q-Col={q_col_index}, A-Col={ans_col_index}")

        # --- Step 2: Prepare Tasks for Parallel Execution ---
        tasks = []
        for row in range(2, ws.max_row + 1):
            if ws.row_dimensions[row].hidden: continue

            question_text = ws.cell(row=row, column=q_col_index).value
            if question_text:
                tasks.append((row, question_text, store_name))

        # --- Step 3: Execute in Parallel ---
        # This dramatically speeds up processing by running up to MAX_WORKERS queries at once
        results = {}
        with concurrent.futures.ThreadPoolExecutor(max_workers=MAX_WORKERS) as executor:
            # Map returns results in order
            future_results = executor.map(_process_single_question, tasks)
            for row_idx, ans in future_results:
                results[row_idx] = ans

        # --- Step 4: Write Results Sequentially ---
        for row, ans in results.items():
            ws.cell(row=row, column=ans_col_index, value=ans)

    wb.save(output_path)
    return output_path

def process_bulk_docx(input_path, output_path, store_name, target_column):
    """
    Docx Processor (Kept Serial for safety with document object manipulation)
    """
    doc = Document(input_path)

    # --- Mode A: Paragraphs ---
    for para in doc.paragraphs:
        text = para.text.strip()
        if not text: continue

        if text.endswith('?') or para.style.name.startswith('List'):
            ans = chat_with_docs(text, store_name=store_name)
            # Append answer starting with "Answer:" as requested
            run = para.add_run(f'\nAnswer: {ans}')
            run.font.color.rgb = docx.shared.RGBColor(0, 100, 200)

    # --- Mode B: Tables ---
    for table in doc.tables:
        if not table.rows: continue
        q_idx = -1
        a_idx = -1

        # Scan header for target_column
        for i, cell in enumerate(table.rows[0].cells):
            txt = cell.text.lower()
            if any(k in txt for k in ['question', 'query']): q_idx = i
            # Look for target column name
            elif target_column.lower() in txt or any(k in txt for k in ['answer', 'response', 'ai']): a_idx = i

        if q_idx != -1 and a_idx != -1:
            for row in table.rows[1:]:
                q_text = row.cells[q_idx].text.strip()
                if q_text:
                    ans = chat_with_docs(q_text, store_name=store_name)
                    row.cells[a_idx].text = ans

    doc.save(output_path)
    return output_path