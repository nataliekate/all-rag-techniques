import os
import uuid
from flask import Flask, request, jsonify, send_file, session
from flask_cors import CORS
from flask_session import Session
from routes.auth import auth_bp
from routes.github_bp import github_bp
from rag_app import chat_with_docs, index_files, process_bulk_file

app = Flask(__name__)

# --- CONFIG ---
app.config['SECRET_KEY'] = 'dev-secret-key'
app.config['SESSION_TYPE'] = 'filesystem'
app.config['SESSION_PERMANENT'] = True
app.config['SESSION_USE_SIGNER'] = True
app.config['SESSION_COOKIE_HTTPONLY'] = True
app.config['SESSION_COOKIE_SAMESITE'] = 'Lax'

Session(app)
CORS(app, supports_credentials=True, origins=["http://localhost:3000"])

app.register_blueprint(auth_bp, url_prefix='/api/auth')
app.register_blueprint(github_bp, url_prefix='/api/github')

UPLOAD_DIR = "uploaded_files"
BULK_DIR = "bulk_processing"
os.makedirs(UPLOAD_DIR, exist_ok=True)
os.makedirs(BULK_DIR, exist_ok=True)

@app.route('/api/chat', methods=['POST'])
def chat():
    if 'user_id' not in session: return jsonify({"error": "Unauthorized"}), 401
    data = request.json
    try:
        answer = chat_with_docs(data.get("query"), store_name=data.get("store_name", "all"))
        return jsonify({"answer": answer})
    except Exception as e: return jsonify({"error": str(e)}), 500

@app.route('/api/upload', methods=['POST'])
def upload_document():
    if 'user_id' not in session: return jsonify({"error": "Unauthorized"}), 401
    file = request.files.get('file')
    if not file: return jsonify({"error": "No file"}), 400

    file_path = os.path.join(UPLOAD_DIR, file.filename)
    file.save(file_path)

    try:
        index_files([file_path], store_name="uploads")
        return jsonify({"status": "indexed", "filename": file.filename})
    except Exception as e: return jsonify({"error": str(e)}), 500

@app.route('/api/bulk-qa', methods=['POST'])
def bulk_qa():
    if 'user_id' not in session: return jsonify({"error": "Unauthorized"}), 401
    file = request.files.get('file')
    if not file: return jsonify({"error": "No file"}), 400

    unique_id = str(uuid.uuid4())
    ext = os.path.splitext(file.filename)[1]
    input_path = os.path.join(BULK_DIR, f"input_{unique_id}{ext}")
    output_path = os.path.join(BULK_DIR, f"processed_{file.filename}")

    file.save(input_path)

    try:
        process_bulk_file(input_path, output_path, store_name="all")
        return send_file(output_path, as_attachment=True, download_name=f"Processed_{file.filename}")
    except Exception as e:
        print(f"Bulk Error: {e}")
        return jsonify({"error": str(e)}), 500

if __name__ == '__main__':
    print("🚀 Server running on http://localhost:5000")
    app.run(debug=True, port=5000)