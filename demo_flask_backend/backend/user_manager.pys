import json
import os

DB_FILE = 'users.json'

def load_users():
    """Reads all users from the JSON file."""
    if not os.path.exists(DB_FILE):
        return []
    try:
        with open(DB_FILE, 'r') as f:
            return json.load(f)
    except (json.JSONDecodeError, IOError):
        return []

def save_user(username, password_hash):
    """Appends a new user to the JSON file."""
    users = load_users()

    # Check if user already exists
    if any(u['username'] == username for u in users):
        return False # User exists

    # Generate a simple ID
    new_id = len(users) + 1

    new_user = {
        "id": new_id,
        "username": username,
        "password_hash": password_hash
    }

    users.append(new_user)

    with open(DB_FILE, 'w') as f:
        json.dump(users, f, indent=2)

    return True

def find_user_by_username(username):
    """Finds a user dict by username."""
    users = load_users()
    for user in users:
        if user['username'] == username:
            return user
    return None

def find_user_by_id(user_id):
    """Finds a user dict by ID."""
    users = load_users()
    for user in users:
        if user['id'] == user_id:
            return user
    return None

def update_user_github_token(user_id, token_data):
    """Updates a specific user's record with GitHub token data."""
    users = load_users()
    updated = False

    for user in users:
        if user['id'] == user_id:
            user['github_token'] = token_data
            updated = True
            break

    if updated:
        with open(DB_FILE, 'w') as f:
            json.dump(users, f, indent=2)

    return updated